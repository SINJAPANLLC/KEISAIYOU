  function mapAirtableStatus(s: string): string {
    const m: Record<string, string> = {
      "⓪架電後検討": "contacted",
      "①弊社待ち":   "contacted",
      "②トス":       "interested",
      "③トス後検討": "interested",
      "④研修":       "hired",
      "⑤成約":       "hired",
      "見送り":       "rejected",
      "辞退":        "rejected",
      "不通":        "new",
    };
